{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: Auto Build",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/build.ps1",
                "-Language",
                "C++",
                "-Mode",
                "Auto",
                "-SourceFile",
                "${file}"
            ],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "C++: Build Executable",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/build.ps1",
                "-Language",
                "C++",
                "-Mode",
                "Executable",
                "-SourceFile",
                "${file}"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "C++: Build Objects",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/build.ps1",
                "-Language",
                "C++",
                "-Mode",
                "Object",
                "-SourceFile",
                "${file}"
            ],
            "problemMatcher": ["$gcc"]
        }
    ]
}